{# Shared layout of the error pages (prod only; in dev Symfony shows its debug page, preview them at /_error/404). #}
{% extends '@AcMarcheSepulture/base.html.twig' %}

{% block title %}{{ block('heading') }} - {{ parent() }}{% endblock %}

{% block body -%}
    <div class="row justify-content-center py-5">
        <div class="col-lg-8 col-xl-7 text-center">
            <div class="display-1 text-secondary mb-3" aria-hidden="true">
                <i class="ti {% block icon %}ti-alert-triangle{% endblock %}"></i>
            </div>
            <p class="text-uppercase text-muted small mb-1">Erreur {{ status_code }}</p>
            <h1 class="h2 mb-3">{% block heading %}Une erreur est survenue{% endblock %}</h1>
            <div class="lead text-muted mb-4">
                {% block message %}{% endblock %}
            </div>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                {% block actions %}
                    <a href="{{ path('home') }}" class="btn btn-primary">
                        <i class="ti ti-home"></i> Retour à l'accueil
                    </a>
                    <a href="{{ path('sepulture') }}" class="btn btn-outline-secondary">
                        <i class="ti ti-search"></i> Rechercher une sépulture
                    </a>
                {% endblock %}
            </div>
        </div>
    </div>
{%- endblock %}
