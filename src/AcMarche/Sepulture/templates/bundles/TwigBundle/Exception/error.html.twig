{% extends '@Twig/Exception/_layout.html.twig' %}

{% block icon %}{{ status_code >= 500 ? 'ti-tool' : 'ti-alert-triangle' }}{% endblock %}

{% block heading %}Oups, une erreur est survenue{% endblock %}

{% block message %}
    {% if status_code >= 500 %}
        <p>Le serveur a rencontré un problème et n'a pas pu afficher cette page.</p>
        <p class="mb-0 fs-6">Le service informatique a été prévenu automatiquement. Veuillez réessayer dans quelques instants.</p>
    {% else %}
        <p>La requête n'a pas pu être traitée ({{ status_code }} {{ status_text }}).</p>
    {% endif %}
{% endblock %}
